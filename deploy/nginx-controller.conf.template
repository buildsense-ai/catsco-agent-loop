server {
    listen 19993 ssl;
    listen [::]:19993 ssl;
    server_name __ARTIFACT_HOST__;

    ssl_certificate /etc/letsencrypt/live/__ARTIFACT_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__ARTIFACT_HOST__/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:19992;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }
}
