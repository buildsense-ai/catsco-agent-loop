# CatsCompany
CATSLOOP_CATSCO_BASE_URL=https://app.catsco.cc
CATSLOOP_CATSCO_TOKEN=
CATSLOOP_CATSCO_ACCOUNT=
CATSLOOP_CATSCO_PASSWORD=
CATSLOOP_CONTROLLER_UID=363
CATSLOOP_MONDAY_UID=553
CATSLOOP_DEVELOPER_UID=365

# GitHub read identity used by the Controller
GH_TOKEN=
CATSLOOP_MONDAY_GITHUB_LOGIN=
CATSLOOP_DEVELOPER_GITHUB_LOGIN=

# Controller
CATSLOOP_OPERATOR_TOKEN=
CATSLOOP_STATE_DIR=./.runtime/runs
CATSLOOP_CONFIG=/etc/catsco-agent-loop/config.json
CATSLOOP_HOST=127.0.0.1
CATSLOOP_PORT=19992
CATSLOOP_ALLOWED_ORIGIN=
CATSLOOP_MAX_ACTIVE_RUNS=1
CATSLOOP_STAGE_TIMEOUT_MS=5400000
CATSLOOP_ACTIVITY_STALL_MS=1200000
CATSLOOP_RUN_ABSOLUTE_TIMEOUT_MS=14400000
